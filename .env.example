# ============================================================================
# CodeMentor AI — Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials as needed.
# When GEMINI_API_KEY is omitted, CodeMentor AI runs in clearly labeled
# Educational Demo Mode (never pretending simulated responses are live AI).
# ============================================================================

# 1. Database (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# 2. AI Provider Configuration (Google Gemini)
# Obtain an API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 3. Isolated Code Execution Service (Judge0 CE / RapidAPI or Self-Hosted)
# Leave empty to keep execution disabled (static analysis & explanations still work).
# Example RapidAPI URL: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=""
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# 4. Application URL (Optional)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
